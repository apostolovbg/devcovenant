include README.md
include LICENSE
include licenses/THIRD_PARTY_LICENSES.md
recursive-include licenses *.txt
include requirements.in
include requirements.lock
include devcovenant/README.md
include devcovenant/VERSION
recursive-include devcovenant/core/contracts/invariants *.yaml
include devcovenant/logs/README.md
recursive-include devcovenant/docs *
